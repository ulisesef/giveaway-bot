@bot.event
async def on_ready():
    print(f"Bot is online: {bot.user}")

class GiveawayView(View):
    def __init__(self, message: discord.Message):
        super().__init__(timeout=None)
        self.participants = []
        self.message = message

    @discord.ui.button(label="Participate", style=discord.ButtonStyle.primary)
    async def join(self, interaction: discord.Interaction, button: Button):
        role = interaction.guild.get_role(REQUIRED_ROLE_ID)
      
        if role and role not in interaction.user.roles:
            await interaction.response.send_message("You need the **@jefuitor** role to participate.", ephemeral=True)
            return

        if interaction.user.id in self.participants:
            await interaction.response.send_message("You are already participating.", ephemeral=True)
            return

        self.participants.append(interaction.user.id)

        # Actualizare corectă Entries (index 2)
        embed = self.message.embeds[0]
        embed.set_field_at(2, name="Entries", value=f"`{len(self.participants)}`", inline=True)
        await self.message.edit(embed=embed)

        await interaction.response.send_message("You have successfully joined the giveaway! ✅", ephemeral=True)


@bot.command()
@commands.has_permissions(administrator=True)
async def gw(ctx, duration: str, winners: int, *, prize: str):
    time_convert = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    unit = duration[-1].lower()
    try:
        time_seconds = int(duration[:-1]) * time_convert[unit]
    except:
        return await ctx.send("Invalid time format! Example: `1h`, `30m`, `2d`")

    end_time = datetime.utcnow() + timedelta(seconds=time_seconds)

    # ================== STIL NOU - GIVEAWAY ACTIV ==================
    embed = discord.Embed(
        title="🎉 GIVEAWAY",
        description=f"**{prize}**",
        color=0x00b7ff,
        timestamp=end_time
    )
    
    embed.set_image(url=BANNER_URL)
    
    embed.add_field(name="Host", value=ctx.author.mention, inline=True)
    embed.add_field(name="Requirement Role", value=f"<@&{REQUIRED_ROLE_ID}>", inline=True)
    embed.add_field(name="Entries", value="`0`", inline=True)
    embed.add_field(name="Winners", value=f"`{winners}`", inline=True)
    embed.add_field(name="Ends", value=f"<t:{int(end_time.timestamp())}:R>", inline=False)
    
    embed.set_footer(text="Click the button below to participate • Good luck!")

    msg = await ctx.send(embed=embed)
    view = GiveawayView(message=msg)
    await msg.edit(view=view)

    await asyncio.sleep(time_seconds)

    # ================== STIL NOU - GIVEAWAY TERMINAT ==================
    if view.participants:
        winners_list = random.sample(view.participants, min(winners, len(view.participants)))
        winner_mentions = ", ".join(f"<@{wid}>" for wid in winners_list)
    else:
        winner_mentions = "No participants 😔"

    ended = discord.Embed(
        title="🏁 GIVEAWAY ENDED",
        description=f"**{prize}**",
        color=0x00b7ff,
        timestamp=datetime.utcnow()
    )
    
    ended.set_image(url=ENDED_BANNER_URL)

    ended.add_field(name="Host", value=ctx.author.mention, inline=True)
    ended.add_field(name="Requirement Role", value=f"<@&{REQUIRED_ROLE_ID}>", inline=True)
    ended.add_field(name="Entries", value=f"`{len(view.participants)}`", inline=True)
    ended.add_field(name="Winners", value=f"`{winners}`", inline=True)
    ended.add_field(name="Ended", value=f"<t:{int(end_time.timestamp())}:F>", inline=False)
    ended.add_field(name="Winner(s)", value=winner_mentions, inline=False)

    await msg.edit(embed=ended, view=None)
    await ctx.send(f"🎉 Giveaway finished! Congratulations {winner_mentions}")


